APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Dates (booking days, "today") are computed in this zone.
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the documented setup (see README). For a quick local run you can
# instead set DB_CONNECTION=sqlite and comment out the other DB_* lines
# (Laravel then uses database/database.sqlite).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=car_rental
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: Google Gemini key for /api/ai/recommendations/parse natural-language
# parsing. Without it the API falls back to keyword parsing.
GEMINI_API_KEY=
# Gemini model used for parsing (calls time out after 5s, then keywords are used).
GEMINI_MODEL=gemini-3.6-flash

# AI recommender service (ML/service/app.py, started with uvicorn on port 8001).
# Recommendations are ranked by its KNN + demand model; if it is not running,
# the API falls back to rule-based scoring in PHP. Leave empty to turn AI ranking off.
AI_RECOMMENDER_URL=http://127.0.0.1:8001
AI_RECOMMENDER_TIMEOUT=3

# Share of recommendation requests that get one adjacent pair of top results swapped (unbiased logs).
RECOMMENDATION_EXPLORE_RATE=0.1
